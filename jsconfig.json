{
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "checkJs": false,
        "jsx": "react-jsx",
        "baseUrl": "src",
        "resolveJsonModule": true,
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["vite/client"],
        "allowJs": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "build"]
}
